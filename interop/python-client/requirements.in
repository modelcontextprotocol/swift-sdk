# The Python side of the interop matrix (interop/README.md): a pinned
# release of the Python SDK from PyPI, and its conformance server from the
# commit of the same tag (v2.3.0) on GitHub (it is not published to PyPI).
# Keep the two in step, and update examples.sha256 for the example servers
# that scripts/run-interop.sh downloads from that commit.
#
# requirements.txt is the hashed lock of everything but the git dependency,
# which the commit pins. Regenerate it after a change here:
#
#   uv pip compile --generate-hashes --universal --python-version 3.12 \
#       --no-emit-package mcp-everything-server requirements.in -o requirements.txt
mcp==2.3.0
mcp-everything-server @ git+https://github.com/modelcontextprotocol/python-sdk@2118f14f8a19bc158d8a1cf90af58d85d187f849#subdirectory=examples/servers/everything-server
